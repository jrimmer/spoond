#!/bin/bash
# spoond-guest-init — E2B template start command. Runs once while the
# template is built; the template is snapshotted after the ready command
# (test -f /run/spoond-guest-ready) succeeds, so everything done here is in
# every sandbox's restored memory and disk.
set -u
# Resolve only through the configured spoond resolvers. The addresses are
# baked at image build as /etc/spoond/guest-dns (SPOOND_GUEST_DNS_ADDR), one
# per comma-separated entry. No public fallback: public DNS answers the
# deployment's wildcard host with the public edge, where credentialed calls
# must never go, and a router may give stale answers. Each resolver gets a
# nameserver line and the lookup retries a couple of times with a short
# timeout before moving on (rotate spreads queries across them). Empty =
# keep the image's resolv.conf.
GUEST_DNS="$(cat /etc/spoond/guest-dns 2>/dev/null || true)"
if [ -n "$GUEST_DNS" ]; then
  rm -f /etc/resolv.conf
  {
    IFS=','
    for addr in $GUEST_DNS; do
      # Trim surrounding whitespace without external tools.
      addr="${addr#"${addr%%[![:space:]]*}"}"
      addr="${addr%"${addr##*[![:space:]]}"}"
      [ -n "$addr" ] && printf 'nameserver %s\n' "$addr"
    done
  } > /etc/resolv.conf
  printf 'options timeout:2 attempts:3 rotate\n' >> /etc/resolv.conf
fi
# Empty dpkg's statoverride. Tools that unpack a base image over the live
# root (kaniko) keep this file while replacing /etc/group, so any override
# whose group the base lacks (E2B's chrony adds _chrony; images with dbus
# carry messagebus) makes apt abort. Overrides only reapply when those
# packages are reconfigured, which ephemeral sandboxes do not need.
if [ -f /var/lib/dpkg/statoverride ]; then
  : > /var/lib/dpkg/statoverride
fi
# Undo the world-writable modes E2B's template finalize step leaves
# (#124): it runs chmod -R 777 /usr/local and /code, and writes envd 0777,
# so any unprivileged user in the guest could replace binaries root runs
# (this script, e2b-provision-runner, envd). Root keeps write access;
# /code stays a shared workspace, sticky like /tmp.
chmod -R go-w /usr/local 2>/dev/null
[ -e /usr/bin/envd ] && chmod 0755 /usr/bin/envd
[ -d /code ] && chmod 1777 /code
# A container marker: container-aware tools (kaniko)
# otherwise warn that they run outside a container.
: > /.dockerenv
for h in /etc/spoond/init.d/*; do
  [ -x "$h" ] || continue
  echo "spoond-guest-init: running $h"
  if ! "$h"; then
    echo "spoond-guest-init: hook $h failed" >&2
    touch /run/spoond-guest-failed
    exec sleep infinity
  fi
done
touch /run/spoond-guest-ready
exec sleep infinity
