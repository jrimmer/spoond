<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>spoond</title>
<link rel="stylesheet" href="/static/vendor/webtui/full.css">
<link rel="stylesheet" href="/static/css/grid.css">
<link rel="stylesheet" href="/static/fonts/jetbrains-mono.css">
<style>
:root {
  --bg: #0c0c0d;
  --fg: #c9c9c9;
  --dim: #6b6b6b;
  --frame: #3a3a40;
  --title: #6FD8E8;
  --ok: #6EF59A;
  --warn: #FFC46B;
  --bad: #FF7A85;
  --state: #86A9FF;
  --spark: #6FD8E8;
  --link: #86A9FF;
  --banner: #FFC46B;
  --owner: #B09AFF;
  --head: #f2f2f2;
}
/* The page still scrolls; it just shows no scrollbar beside the grid. */
html, body { scrollbar-width: none; }
html::-webkit-scrollbar, body::-webkit-scrollbar { display: none; }
</style>
<script type="module" src="/static/vendor/datastar-rocket.js"></script>
</head>
<body data-webtui-theme="dark" data-signals="{{signals .}}" data-init="@get('/stream')">
<main>
<pre id="grid" class="grid" data-webtui-theme="dark">{{.Grid}}</pre>
</main>
</body>
</html>
