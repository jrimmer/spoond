# Secrets / credentials — never commit
*.env
*.pem
*.key
*.pkcs8
*.crt
*.pub
/dev/.dev.vars
.dev.vars

# Build artifacts / binaries (source of truth is the build)
/spoond
*.exe
*.test
*.out
/bin/
/dist/

# Editor / OS junk
.DS_Store
*.swp
*~
.idea/
.vscode/
*.iml

# Logs / scratch
/tmp/
*.log
*.pid
__pycache__/

# Conformance suite results (the committed forkd baseline is
# conformance/baseline-forkd.json, outside this directory)
conformance/results/*
!conformance/results/.gitkeep
