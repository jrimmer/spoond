# spoond-backend environment example (/etc/spoond/backend.env, mode 0600)
#
# Copy, fill in, and point the unit's EnvironmentFile at it. See
# docs/setup.md for the full reference. No inline comments in the real
# file: systemd keeps a trailing # as part of the value.

# Required: comma-separated token=consumer pairs.
CONSUMER_TOKENS=changeme=forgejo
# Required: address guests use to reach host services.
HOST_GUEST_SERVICE_ADDR=10.0.0.11
HOST_GUEST_SERVICE_PORT=8891
# Guest DNS resolver: granted on port 53 and baked into the guest image.
# Empty = no resolver allowance.
SPOOND_GUEST_DNS_ADDR=10.0.0.2
# Wildcard hostname suffix the HTTP proxy routes.
SPOOND_PROXY_HOST_SUFFIX=.sandbox.example.com

E2B_GRPC_ADDR=127.0.0.1:5008
E2B_PROXY_URL=http://127.0.0.1:5007
E2B_TOKEN_SEED_FILE=/etc/spoond/e2b-token-seed
E2B_TEMPLATE_STORAGE_PATH=/forkdcache/e2b/storage/templates
IMAGE_REGISTRY=localhost:5000
SPOOND_DB_PATH=/var/lib/spoond/spoond.db
SPOOND_BACKUP_DIR=/var/lib/spoond/backups
BIND_ADDR=127.0.0.1:8890
PROXY_ADDR=0.0.0.0:8891
TLS_CERT=/etc/spoond/tls/fullchain.pem
TLS_KEY=/etc/spoond/tls/privkey.pem
