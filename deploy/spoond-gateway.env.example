# spoond-sshd-gateway environment example (/etc/spoond-gateway.env, mode 0600)

# Required: backend service token (admin-equivalent; keep out of ExecStart).
SPOOND_GATEWAY_TOKEN=changeme
# Public hostname advertised in MOTDs; default sandbox.example.com.
SPOOND_GATEWAY_HOST=sandbox.example.com
# Host-service address/port guests use; also the default base for the
# shelley binary and LLM gateway URLs below.
HOST_GUEST_SERVICE_ADDR=10.0.0.11
HOST_GUEST_SERVICE_PORT=8891
# Explicit base URLs (optional; derived from the host-service address
# above when unset).
SHELLY_BINARY_URL=http://10.0.0.11:8891/assets/shelley
LLM_GATEWAY_URL=http://10.0.0.11:8891/llm/
