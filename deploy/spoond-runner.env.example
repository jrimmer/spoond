# spoond-runner environment example (/etc/spoond/runner.env)
#
# Registers as a Forgejo Actions runner and leases sandboxes as CI
# workers. See docs/ci-jobs.md and docs/setup.md.

# Required: Forgejo instance base URL (no default).
FORGEJO_URL=https://code.example.com
# Required: registration token.
RUNNER_TOKEN=changeme
# Required: lease API base URL and bearer token.
LEASE_URL=http://127.0.0.1:8890
LEASE_TOKEN=changeme
# Optional: per-project lease identity. A job from a mapped repository
# (owner/repo) or owner leases with the token in that file (0600), so
# fair shares count its CI as its own; anything unmapped uses
# LEASE_TOKEN. See "Per-project lease identity" in docs/ci-jobs.md.
#LEASE_TOKEN_MAP=example.org/site=/etc/spoond/lease-tokens/site,acme=/etc/spoond/lease-tokens/acme
# Git host base URL for actions/checkout clones (no default).
REPO_BASE_URL=https://code.example.com

# Labels the runner registers with Forgejo (default ubuntu-latest), and
# runs-on label -> image. Every mapped image needs a current build
# (spoond images build <name>). Workers that restore saved credentials
# from RUNNER_STATE_FILE do not re-send labels: after changing
# RUNNER_LABELS see "Adding a label" in docs/ci-jobs.md.
#
# DEFAULT_IMAGE is the image for a job whose labels IMAGE_MAP does not
# map. Neither has a default: a job that maps through neither fails
# before a sandbox is created, and a runner with both unset warns at
# startup.
RUNNER_LABELS=ubuntu-latest,gpu
IMAGE_MAP=ubuntu-latest=ci-image,gpu=gpu-ci-image
DEFAULT_IMAGE=ci-image
LEASE_TTL=600
LEASE_NETPOL=internet
