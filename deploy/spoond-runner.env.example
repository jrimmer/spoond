# spoond-runner environment example (/etc/spoond-runner.env)
#
# Registers as a Forgejo Actions runner and leases sandboxes as CI
# workers. See docs/ci-jobs.md and docs/setup.md.

# Required: Forgejo instance base URL (no default).
FORGEJO_URL=https://code.example.com
# Required: registration token.
RUNNER_TOKEN=changeme
# Required: lease API base URL and bearer token.
LEASE_URL=http://127.0.0.1:8890
LEASE_TOKEN=changeme
# Git host base URL for actions/checkout clones (no default).
REPO_BASE_URL=https://code.example.com

IMAGE_MAP=ubuntu-latest=py-base
DEFAULT_IMAGE=py-base
LEASE_TTL=600
LEASE_NETPOL=internet
