[Unit]
Description=spoond lease API backend (microVM lease service)
After=network-online.target e2b-orchestrator.service
Wants=network-online.target e2b-orchestrator.service

[Service]
Type=simple
ExecStart=/opt/spoond/spoond backend
Restart=on-failure
RestartSec=3
Environment=BIND_ADDR=127.0.0.1:8890
# Consumer tokens: token=consumer,comma-separated. Set via EnvironmentFile.
# llm.env first, backend.env second: a later file wins, so backend.env is
# the operator's single file and llm.env may override BIND_ADDR/PROXY_ADDR
# on hosts that keep the LLM key pair apart. Both carry the leading - so
# a missing file still starts the unit; the backend itself refuses to
# serve without CONSUMER_TOKENS.
EnvironmentFile=-/etc/spoond/llm.env
EnvironmentFile=-/etc/spoond/backend.env
User=root
Group=root

[Install]
WantedBy=multi-user.target
